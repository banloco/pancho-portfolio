# Environment Variables Template
# Copiez ce fichier en .env et remplissez avec vos valeurs

# Site Configuration
VITE_SITE_NAME=Capture
VITE_SITE_URL=https://capture.com

# Contact Information
VITE_CONTACT_EMAIL=contact@capture.com
VITE_CONTACT_PHONE=+33612345678
VITE_CONTACT_ADDRESS=Paris, France

# Social Media Links
VITE_INSTAGRAM_URL=https://instagram.com/capture
VITE_YOUTUBE_URL=https://youtube.com/@capture
VITE_FACEBOOK_URL=https://facebook.com/capture
VITE_LINKEDIN_URL=https://linkedin.com/in/capture
VITE_TWITTER_URL=https://twitter.com/capture

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_FACEBOOK_PIXEL_ID=

# Form Handling (Optional - Use a service like Formspree, EmailJS, etc.)
VITE_FORM_ENDPOINT=

# API Keys (if needed)
VITE_API_KEY=
